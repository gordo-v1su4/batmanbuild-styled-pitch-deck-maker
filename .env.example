# Kimi / Moonshot AI (for story generation, script polish, episode breaking, scene prompts)
# Get your API key from https://platform.moonshot.ai or https://kimi.com
KIMI_API_KEY=sk-moonshot-your-key-here

# Optional: Override API base (auto-detected from key prefix)
# sk-moonshot-* → https://api.moonshot.ai/v1 (OpenAI protocol)
# sk-kimi-*     → https://api.kimi.com/coding (Anthropic protocol)
# KIMI_API_BASE=https://api.moonshot.ai/v1

# Optional: Override protocol (auto-detected from base URL)
# KIMI_API_PROTOCOL=openai|anthropic

# Optional: Override model (default: kimi-k2.6 for OpenAI, kimi-for-coding for Anthropic)
# KIMI_MODEL=kimi-k2.6

# Gemini API (for image generation only — Imagen)
# Get your API key from https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your-gemini-key-here
